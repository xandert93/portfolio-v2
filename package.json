{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "seed": "dotenv -e .env.local -- tsx src/sanity/seed/seed.ts",
    "type-check": "tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typegen": "sanity schema extract --force --enforce-required-fields --path=./src/sanity/schema.json && sanity typegen generate",
    "sanity:deploy": "cross-env SANITY_STUDIO_DATASET=production sanity deploy"
  },
  "dependencies": {
    "@portabletext/react": "^6.2.0",
    "@sanity/code-input": "^7.3.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.5.0",
    "axios": "^1.17.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.41.0",
    "lucide-react": "^1.17.0",
    "nanoid": "^5.1.14",
    "next": "16.2.7",
    "next-sanity": "^13.1.5",
    "next-themes": "^0.4.6",
    "p-limit": "^7.3.1",
    "pluralize": "^8.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "resend": "^6.14.0",
    "sanity": "^6.5.0",
    "shiki": "^4.2.0",
    "simple-icons": "^16.24.0",
    "styled-components": "^6.5.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "postcss": "^8.5.15",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  }
}
